{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "web-app0",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "99c04bf9-2d4a-4e8a-b34b-35ec5a6ac971","database_name": "web-app0" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "94938e8ad2134d2ab766c50c1eaf9011" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
